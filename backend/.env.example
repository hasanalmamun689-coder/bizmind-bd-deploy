# Local development. In production these are set in the Render dashboard (see render.yaml).
# Neon gives you "postgresql://user:pass@host/db?sslmode=require" - paste it as-is,
# the app converts it automatically.
DATABASE_URL=postgresql+psycopg2://smeuser:smepassword@localhost:5432/sme_intelligence
JWT_SECRET=change-this-to-a-long-random-value
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=
ENVIRONMENT=development
